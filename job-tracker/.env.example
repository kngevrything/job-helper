# Copy this file to .env (docker compose) or .env.local (npm run dev) and
# fill in real values. Never commit the real file -- .gitignore already
# excludes .env* (except this example).

# MongoDB connection string.
# - Using `docker compose up`: leave this as-is to use the bundled `mongo`
#   service defined in docker-compose.yml.
# - Running without Docker, or pointing at your own MongoDB instance: set
#   this to that instance's connection string instead.
MONGODB_URI=mongodb://mongo:27017/jobtracker

# Absolute path on your HOST machine where application folders (and copies
# of your resume/cover letter) should be created. This gets bind-mounted
# into the container, so point it at a real folder you can browse in your
# normal file manager and sync with OneDrive/Dropbox/etc. if you want.
# Only used by docker-compose.yml -- if running with `npm run dev` instead,
# set APPLICATIONS_ROOT directly in .env.local to this same path.
HOST_APPLICATIONS_DIR=/path/to/your/applications/folder

# Filenames (not full paths) of your base resume/cover letter template
# files. These must already exist directly inside HOST_APPLICATIONS_DIR.
BASE_RESUME_FILENAME=Resume.docx
BASE_COVER_LETTER_FILENAME=Cover Letter.docx
